# APP_URL: The public canonical URL where VidNova AI is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional Server-Only Environment Variable (NOT required to run VidNova AI):
# On Vercel or self-hosted Node, you may optionally set a free read-only Hugging Face
# token (`hf_...`) as `HF_TOKEN` in server environment settings for higher ZeroGPU quota.
# Never expose tokens in client-side `VITE_*` variables.
